# Browser origins allowed to call this public API. Replace * with a
# comma-separated allowlist when the API is not intended for general use.
CORS_ORIGINS=*

# KanjiVG upstream requests and index cache.
HTTP_TIMEOUT_SECONDS=20
KANJIVG_INDEX_CACHE_SECONDS=86400

# Docker build option; set false when only the Google provider is needed.
INSTALL_LOCAL_OCR=true

# Local Tesseract settings. PSM 10 treats the crop as a single character.
OCR_TESSERACT_LANGUAGE=jpn
OCR_TESSERACT_PSM=10

# Required only for requests containing `"provider": "google"`.
GOOGLE_VISION_API_KEY=

# Applies to both providers. The limiter is per process and resets on restart.
OCR_MAX_IMAGE_BYTES=5242880
OCR_RATE_LIMIT_PER_HOUR=20
OCR_TIMEOUT_SECONDS=20
